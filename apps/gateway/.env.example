GATEWAY_INSTANCE_ID=gateway-local
GATEWAY_ADDR=:8081
GATEWAY_TOKEN_SECRET=gateway-dev-secret-change-me

DATABASE_URL=postgres://postgres@127.0.0.1:5432/chat_app?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
NATS_URL=nats://127.0.0.1:4222


GATEWAY_HEARTBEAT_INTERVAL=30s
GATEWAY_AUTH_TIMEOUT=5s
GATEWAY_WRITE_TIMEOUT=10s
GATEWAY_SHUTDOWN_TIMEOUT=20s
GATEWAY_OUTBOUND_BUFFER=128
GATEWAY_MAX_SUBSCRIPTIONS=250
GATEWAY_MAX_FRAME_BYTES=65536
GATEWAY_MAX_CONNECTIONS=10000
GATEWAY_MAX_CONNECTIONS_PER_USER=10
GATEWAY_INBOUND_RATE_PER_SECOND=30
GATEWAY_INBOUND_BURST=60
GATEWAY_EVENT_SUBJECT_PREFIX=chat.events.
GATEWAY_TYPING_SUBJECT_PREFIX=chat.typing.

ALLOWED_ORIGINS=http://localhost:8000
